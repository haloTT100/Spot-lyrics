<Window x:Class="lyrics_overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:lyrics_overlay"
        Title="Lyrics Overlay"
        Icon="Assets/AppIcon.ico"
        Width="900"
        Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Window.Resources>
        <local:LineOpacityConverter x:Key="LineOpacityConverter" />
        <local:LineFontSizeConverter x:Key="LineFontSizeConverter" />
        <local:LineWeightConverter x:Key="LineWeightConverter" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <local:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter" />
        <local:SecondaryLineFontSizeConverter x:Key="SecondaryLineFontSizeConverter" />
    </Window.Resources>

    <Border x:Name="OverlayBorder"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="0"
            Padding="4">
        <ItemsControl x:Name="LyricsItemsControl"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:DisplayLyricLine}">
                    <Grid Margin="0,4,0,4">
                        <!-- Non-karaoke lines -->
                        <StackPanel Visibility="{Binding IsKaraokeLine, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                    HorizontalAlignment="Stretch">
                            <TextBlock Text="{Binding Text}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Opacity="{Binding DistanceFromCurrent, Converter={StaticResource LineOpacityConverter}}"
                                       FontSize="{Binding DistanceFromCurrent, Converter={StaticResource LineFontSizeConverter}}"
                                       FontWeight="{Binding DistanceFromCurrent, Converter={StaticResource LineWeightConverter}}"
                                       Foreground="White">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="8"
                                                      ShadowDepth="0"
                                                      Color="Black"
                                                      Opacity="0.9" />
                                </TextBlock.Effect>
                            </TextBlock>

                            <TextBlock Text="{Binding SecondaryText}"
                                       Visibility="{Binding SecondaryText, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"
                                       Opacity="{Binding DistanceFromCurrent, Converter={StaticResource LineOpacityConverter}}"
                                       FontSize="{Binding DistanceFromCurrent, Converter={StaticResource SecondaryLineFontSizeConverter}}"
                                       FontWeight="Medium"
                                       Foreground="#D8FFFFFF">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="8"
                                                      ShadowDepth="0"
                                                      Color="Black"
                                                      Opacity="0.9" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>

                        <!-- Karaoke lines -->
                        <StackPanel Visibility="{Binding IsKaraokeLine, Converter={StaticResource BoolToVisibilityConverter}}"
                                    HorizontalAlignment="Stretch">
                            <!-- Original lyric above -->
                            <TextBlock Text="{Binding Text}"
                                       Visibility="{Binding Text, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,2"
                                       Opacity="{Binding DistanceFromCurrent, Converter={StaticResource LineOpacityConverter}}"
                                       FontSize="{Binding DistanceFromCurrent, Converter={StaticResource SecondaryLineFontSizeConverter}}"
                                       FontWeight="Medium"
                                       Foreground="#F0FFFFFF">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="8"
                                                      ShadowDepth="0"
                                                      Color="Black"
                                                      Opacity="0.95" />
                                </TextBlock.Effect>
                            </TextBlock>

                            <!-- Romanji / karaoke segmented line below -->
                            <ItemsControl ItemsSource="{Binding Segments}"
                                          HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"
                                                   HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:DisplayKaraokeSegment}">
                                        <TextBlock Text="{Binding Text}"
                                                   Margin="0"
                                                   Padding="0"
                                                   TextAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   FontSize="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.DistanceFromCurrent, Converter={StaticResource LineFontSizeConverter}}"
                                                   FontWeight="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.DistanceFromCurrent, Converter={StaticResource LineWeightConverter}}"
                                                   Foreground="{Binding ForegroundBrush}"
                                                   Opacity="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.DistanceFromCurrent, Converter={StaticResource LineOpacityConverter}}">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="8"
                                                                  ShadowDepth="0"
                                                                  Color="Black"
                                                                  Opacity="0.95" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>